{
  "name": "hyperliquid-basis-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bot.ts",
    "test": "node --test bot.test.ts live.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node --env-file-if-exists=.env live.ts --check",
    "live": "node --env-file-if-exists=.env live.ts --run",
    "close": "node --env-file-if-exists=.env live.ts --close"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
