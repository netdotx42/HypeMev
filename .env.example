# Node.js 24+. Copy to .env and edit locally. Never share private keys in chat.
NETWORK=testnet
LIVE_TRADING=false
# Must also be true before any mainnet order. Check and testnet ignore it.
CONFIRM_MAINNET=false
ACCOUNT_ADDRESS=
# Approved NAMED API wallet for the above master account on this network.
# Do not use your master wallet private key.
AGENT_PRIVATE_KEY=
NOTIONAL_USDC=25
MAX_NOTIONAL_USDC=50
MIN_NET_BPS=30
SLIPPAGE_BPS=10
# Wider cap used only when closing or unwinding. Entry stays on SLIPPAGE_BPS.
EXIT_SLIPPAGE_BPS=50
EXIT_BUFFER_BPS=15
EXIT_BASIS_BPS=5
# Exit when a short's mark is within this many bps of liquidation.
LIQ_BUFFER_BPS=1000
MAX_LOSS_USDC=2
MAX_HOLD_SECONDS=3600
POLL_MS=5000
